{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DG localization mapping v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project", "locales", "provenance_file", "matching", "derivation_rules", "key_overrides", "abbreviations", "entries"],
  "properties": {
    "schema_version": {"const": "2.0.0"},
    "project": {"const": "DG"},
    "locales": {"const": ["en", "vi", "pt-BR"]},
    "provenance_file": {"type": "string", "minLength": 1},
    "matching": {
      "type": "object", "additionalProperties": false,
      "required": ["mode", "case_sensitive", "unicode_normalization", "accent_sensitive", "collapse_whitespace", "apostrophe_equivalence", "word_boundaries", "overlap", "include_aliases", "include_variants", "include_rejected", "ambiguity", "key_scope", "protect", "inflection"],
      "properties": {
        "mode": {"const": "terms_within_text"},
        "case_sensitive": {"const": false},
        "unicode_normalization": {"const": "NFC"},
        "accent_sensitive": {"const": true},
        "collapse_whitespace": {"const": true},
        "apostrophe_equivalence": {"const": ["'", "’"]},
        "word_boundaries": {"const": true},
        "overlap": {"const": "longest_first"},
        "include_aliases": {"const": true},
        "include_variants": {"const": false},
        "include_rejected": {"const": false},
        "ambiguity": {"const": "return_candidates"},
        "key_scope": {"const": "context_hint"},
        "protect": {"const": ["rich_text_tags", "placeholders", "technical_keys"]},
        "inflection": {"const": "explicit_aliases_only"}
      }
    },
    "derivation_rules": {
      "type": "array", "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "key_prefix", "key_suffix", "base_key_suffix", "output_suffix", "store_derived_entries", "copy_description"],
        "properties": {
          "id": {"$ref": "#/$defs/text"},
          "key_prefix": {"$ref": "#/$defs/text"},
          "key_suffix": {"$ref": "#/$defs/text"},
          "base_key_suffix": {"$ref": "#/$defs/text"},
          "output_suffix": {"type": "string"},
          "store_derived_entries": {"const": false},
          "copy_description": {"const": false}
        }
      }
    },
    "key_overrides": {
      "type": "array", "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "operator", "value", "entry_id", "preserve_key"],
        "properties": {
          "id": {"$ref": "#/$defs/text"}, "operator": {"const": "contains"},
          "value": {"$ref": "#/$defs/text"}, "entry_id": {"$ref": "#/$defs/id"},
          "preserve_key": {"const": true}
        }
      }
    },
    "abbreviations": {
      "type": "array", "items": {
        "type": "object", "additionalProperties": false,
        "required": ["entry_id", "expansions"],
        "properties": {
          "entry_id": {"$ref": "#/$defs/id"},
          "expansions": {
            "type": "object", "additionalProperties": false, "required": ["vi", "pt-BR"],
            "properties": {"vi": {"$ref": "#/$defs/text"}, "pt-BR": {"$ref": "#/$defs/text"}}
          }
        }
      }
    },
    "entries": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/entry"}}
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1},
    "id": {"type": "string", "pattern": "^dg\\.[a-z0-9-]+\\.[a-f0-9]{10}$"},
    "locale": {"enum": ["en", "vi", "pt-BR"]},
    "strings": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/text"}},
    "translations": {
      "type": "object", "additionalProperties": false, "required": ["en", "vi", "pt-BR"],
      "properties": {"en": {"$ref": "#/$defs/text"}, "vi": {"$ref": "#/$defs/text"}, "pt-BR": {"$ref": "#/$defs/text"}}
    },
    "entry": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "groups", "translations", "aliases", "keys", "context_required", "variants", "rejected"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "groups": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {
          "enum": ["blessings", "combat", "dice", "enemies", "equipment", "event_terms", "events", "locations", "pet_abilities", "pets", "rarity", "relics", "resources", "skills", "systems", "wrath_monsters"]
        }},
        "translations": {"$ref": "#/$defs/translations"},
        "aliases": {
          "type": "object", "additionalProperties": false, "required": ["en", "vi", "pt-BR"],
          "properties": {"en": {"$ref": "#/$defs/strings"}, "vi": {"$ref": "#/$defs/strings"}, "pt-BR": {"$ref": "#/$defs/strings"}}
        },
        "keys": {"$ref": "#/$defs/strings"},
        "context_required": {"type": "boolean"},
        "variants": {"type": "array", "items": {
          "type": "object", "additionalProperties": false, "required": ["locale", "text", "condition"],
          "properties": {"locale": {"$ref": "#/$defs/locale"}, "text": {"$ref": "#/$defs/text"}, "condition": {"type": "string"}}
        }},
        "rejected": {"type": "array", "items": {
          "type": "object", "additionalProperties": false, "required": ["locale", "forms", "condition"],
          "properties": {"locale": {"$ref": "#/$defs/locale"}, "forms": {"$ref": "#/$defs/strings"}, "condition": {"type": "string"}}
        }}
      }
    }
  }
}
